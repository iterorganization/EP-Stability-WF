easyblock = "MakeCp"

name = "CHEASE"
version = "13.1"

homepage = "https://git.iter.org/projects/EQ/repos/chease"
description = ("The CHEASE code is a fixed-boundary equilibrium code")

local_ddver = "3.35.0"
local_alver = "4.10.0"
versionsuffix = "-DD-%s" % local_ddver

toolchain = SYSTEM
local_intel_version = "2020b"
local_imasver = local_ddver + "-" + local_alver + "-" + local_intel_version

local_tagname = version
source_urls = [
    "https://git.iter.org/rest/api/latest/projects/EQ/repos/%(namelower)s/archive"
    "?at=refs%2Ftags%2F" + local_tagname + "&format=zip&/"
]
sources = [SOURCELOWER_ZIP]
checksums = ['4e4130b3c6b8e7541cc184645e1f11237193a8fe3ed1d42a6779c62cab377d91']

builddependencies = [
]
dependencies = [
    ("cineca", EXTERNAL_MODULE),
    ("intel/pe-xe-2017--binary", EXTERNAL_MODULE),
    ("imasenv/" + local_ddver + "/intel/rc", EXTERNAL_MODULE),
    ("imas-pyal/1.3.5", EXTERNAL_MODULE),
    ("hdf5/1.8.17--intel--pe-xe-2017--binary", EXTERNAL_MODULE),
]

start_dir = "src-f90"

maxparallel = 24
local_targets = ["chease_imas_hdf5", "chease_imas", "chease", "libchease_kepler_imas"]
local_targets = [x for x in local_targets if "hdf5" not in x]

prebuildopts = "rm -f metrictoitm_afterfpp.f90 && "

buildopts = [
    ("CHEASE_MACHINE=gateway_with_itm CHEASE_F90=ifort PYTHON_ACTOR_DIRECTORY=%(installdir)s "
     "VERSION=%(version)s " + " ".join(local_targets))
]

install_cmd = "cd ../; fc2k fc2k_imas/chease.xml -nokepler -pyworkspace %(installdir)s"
postinstallcmds = [install_cmd]

# Copy targets starting with "chease"
local_copy_targets = list(set([i for i in local_targets if i[0:6] == "chease"]))

# Additionally copy all scripts in the "scripts_for_bin" folder
local_copy_targets += [
    "../scripts_for_bin/{}".format(script_name) for script_name in
    [
        "database_pprimeffprime_to_eqdsk",
        "database_to_eqdsk",
        "eqdsk_to_database",
        "o.chease_rz_plasma_boundary_to_cols.pl",
        "o.chease_to_cols",
        "o.chease_to_cols_v10.pl",
        "o.chease_to_cols_v9.pl",
        "run.chease.eqdsk",
        "run.chease.expeq",
    ]
]

files_to_copy = [(local_copy_targets, "bin")]

sanity_check_paths = {
    "files": ["bin/chease"],
    "dirs": ["bin"],
}

modextrapaths = {"PYTHONPATH": "chease"}

sanity_check_commands = [
    "python -c 'from chease.wrapper import chease_actor'",
    "ldd $(which chease_imas)",
]

moduleclass = "phys"
