&global_wrap 

modus=5, ! 1: global antenna, full gap; 2: global antenna track mode; 3: scan complex plane as given by guess_start_1, guess_start_2 with dguess; 4: find local guesses for kinetic continuum close to specified gap; 5: local analytical estimates for various AEs; 6: local and global redcued MHD solve
min_n_tor=10 ! start search from this minimal tor. mode number
max_n_tor=10, ! end search from this max tor. mode number
min_m=10, ! start poloidal node number: typically nq_0=m
max_m=10, ! number of gaps to be searched: for one (main) TAE gap use max_m=min_m
sidebands=2, ! side band poloidal harmonics to be used around peak_m; in analytical estimates for damping only up to 2 is implemented, for ideal MHD can be up tp 20-30 (memory limit depending on npsi....) 
even=0, ! even (ballooning) or odd (anti-ballooning) branch for TAEs to be considered
start_pos=1, ! start from this line on loc_TAE, loc_TAE_mode4, or antenna_mode1/2 files (partial scan)
mode_type=1 ,!0=GAM-EGAM/1=TAE/2=RSAE/3=BAE/4=EAE/5=NAE/6=EPM/7=BAAE/8=KBM/9=ITG ! note slight difference to IMAS standard...mapped in sub_imas_out.F
force_m=.false., ! force poloidal harminics to be min_m to max_m; sometimes useful for benchmarks, otherwise chosem by code itself
offset_d=0.0d, ! add imaginary part of guess : move antenna scan into complex plane: positive to better find strongly growing modes, negative to better find strongly damped modes
npsi_out=128, ! value for radial mapping and output of radial mode structures
kr_read=0.0d0! set radial wave number manually k_th=-m/r, kr typically only plays role when comparable to kth
q0=0.0d    ! set q0 via wrapper to allow for q0 scans while scaling only the equilibrium (not needed in IMAS) 
/

